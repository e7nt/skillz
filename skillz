#!/usr/bin/env bash
# skillz - author skills once, sync to every coding agent.
# Install: curl -fsSL https://skillz.e7nt.com/install.sh | bash
set -euo pipefail

SKILLZ_VERSION="1.0.0"

SKILLZ_HOME="${SKILLZ_HOME:-$HOME/.skillz}"
SKILLS_DIR="$SKILLZ_HOME/skills"
CATALOG="$SKILLZ_HOME/catalog.json"
BASE_URL="${SKILLZ_BASE_URL:-$(cat "$SKILLZ_HOME/base-url" 2>/dev/null || echo "https://skillz.e7nt.com")}"

CODE_SKILLS="${CODEX_HOME:-$HOME/.codex}/skills"
TARGETS=(
  "$HOME/.claude/skills"
  "$CODE_SKILLS"
  "$HOME/.agents/skills"
  "$HOME/.agent/skills"
)

# catalog is a JSON array, one skill object per line.
# line_for <name> - echo the catalog line for that exact name (empty if absent)
line_for() {
  grep -F "\"name\": \"$1\"" "$CATALOG" | head -n 1
}

# field <name> <line> - extract a field value from one catalog line
field() {
  printf '%s' "$2" | sed -n "s/.*\"$1\": *\"\([^\"]*\)\".*/\1/p"
}

# fetch_skill <name> - download every catalog-listed file for a catalog skill
fetch_skill() {
  local name="$1" line files f dest
  line="$(line_for "$name")"
  [ -n "$line" ] || return 1
  files="$(printf '%s' "$line" | sed -n 's/.*"files": *\[\([^]]*\)\].*/\1/p')"
  [ -n "$files" ] || files='"SKILL.md"'
  mkdir -p "$SKILLS_DIR/$name"
  for f in $(printf '%s' "$files" | sed 's/" *, */ /g; s/"//g'); do
    [ -n "$f" ] || continue
    dest="$SKILLS_DIR/$name/$f"
    mkdir -p "$(dirname "$dest")"
    echo "  fetching $f"
    curl -fsSL "$BASE_URL/skills/$name/$f" -o "$dest"
  done
}

cmd_help() {
  cat <<'EOF'
usage: skillz <command>    (ls and rm are short aliases)

  list        show available skills in the catalog (✓ installed)
  add NAME    install a skill from the catalog
  remove NAME uninstall a skill
  new NAME    scaffold a local skill
  sync        link installed skills into Claude, Codex, omp
  update      update skillz, the catalog, and all installed skills
  help        show this help
EOF
}

cmd_list() {
  if [ ! -f "$CATALOG" ]; then
    echo "skillz: no catalog cached - run 'skillz update'" >&2
    return 1
  fi
  echo "available skills (✓ installed):"
  local line name desc
  while IFS= read -r line; do
    name="$(field name "$line")"
    desc="$(field description "$line")"
    if [ -d "$SKILLS_DIR/$name" ]; then
      printf '  ✓  %-16s %s\n' "$name" "$desc"
    else
      printf '  ·  %-16s %s\n' "$name" "$desc"
    fi
  done < <(grep -F '"name"' "$CATALOG")
  for d in "$SKILLS_DIR"/*/; do
    [ -d "$d" ] || continue
    name="$(basename "$d")"
    if [ -z "$(line_for "$name")" ]; then
      printf '  ~  %-16s %s\n' "$name" "(local - not in catalog)"
    fi
  done
}

cmd_add() {
  local name="${1:-}"
  [ -n "$name" ] || { echo "skillz: usage: skillz add <name>" >&2; return 1; }
  [ -f "$CATALOG" ] || { echo "skillz: no catalog cached - run 'skillz update'" >&2; return 1; }
  if [ -z "$(line_for "$name")" ]; then
    echo "skillz: unknown skill '$name' - run 'skillz list'" >&2
    return 1
  fi
  fetch_skill "$name"
  echo "installed '$name' - syncing to agents"
  cmd_sync
}

cmd_remove() {
  local name="${1:-}"
  [ -n "$name" ] || { echo "skillz: usage: skillz remove <name>" >&2; return 1; }
  if [ ! -d "$SKILLS_DIR/$name" ]; then
    echo "skillz: '$name' is not installed - run 'skillz list'" >&2
    return 1
  fi
  rm -rf "$SKILLS_DIR/$name"
  echo "removed '$name' - cleaning agent links"
  cmd_sync
}

cmd_new() {
  local name="${1:-}"
  [ -n "$name" ] || { echo "skillz: usage: skillz new <name>" >&2; return 1; }
  name="${name//[^a-zA-Z0-9._-]/_}"
  [ -n "$name" ] || { echo "skillz: invalid skill name (use letters, digits, . _ -)" >&2; return 1; }
  mkdir -p "$SKILLS_DIR/$name"
  if [ ! -f "$SKILLS_DIR/$name/SKILL.md" ]; then
    cat > "$SKILLS_DIR/$name/SKILL.md" <<EOF
---
name: $name
description: Describe when this skill should be used.
---

# $name

Instructions go here.
EOF
  fi
  echo "created $SKILLS_DIR/$name/SKILL.md - edit it; changes are live via the symlink"
  cmd_sync
}

cmd_sync() {
  mkdir -p "$SKILLS_DIR" "${TARGETS[@]}"
  local count=0 name t link
  for skill in "$SKILLS_DIR"/*/; do
    [ -d "$skill" ] || continue
    skill="${skill%/}"
    name="$(basename "$skill")"
    for t in "${TARGETS[@]}"; do
      if [ -e "$t/$name" ] || [ -L "$t/$name" ]; then
        if [ -L "$t/$name" ] && [ "$(readlink "$t/$name")" = "$skill" ]; then
          continue
        fi
        echo "skillz: warn: $t/$name exists and is not a skillz link - left untouched" >&2
        continue
      fi
      ln -sfn "$skill" "$t/$name"
    done
    count=$((count + 1))
  done
  for t in "${TARGETS[@]}"; do
    for link in "$t"/*; do
      [ -L "$link" ] || continue
      case "$(readlink "$link")" in
        "$SKILLS_DIR"/*) [ -e "$link" ] || rm "$link" ;;
      esac
    done
  done
  echo "synced $count skill(s) into ${#TARGETS[@]} agent locations"
}

cmd_update() {
  local tmp d name
  tmp="$(mktemp "$SKILLZ_HOME/bin/.skillz.XXXXXX")"
  if curl -fsSL "$BASE_URL/skillz" -o "$tmp"; then
    chmod +x "$tmp"
    if ! cmp -s "$tmp" "$SKILLZ_HOME/bin/skillz"; then
      mv "$tmp" "$SKILLZ_HOME/bin/skillz"
      echo "updated skillz to $(grep -m1 '^SKILLZ_VERSION=' "$SKILLZ_HOME/bin/skillz" | cut -d= -f2 | tr -d '"')"
    else
      rm -f "$tmp"
      echo "skillz is up to date ($SKILLZ_VERSION)"
    fi
  else
    rm -f "$tmp"
    echo "skillz: update failed (network?) - keeping current version" >&2
    return 1
  fi
  if curl -fsSL "$BASE_URL/catalog.json" -o "$CATALOG" 2>/dev/null; then
    echo "catalog refreshed"
  else
    echo "skillz: warn: catalog refresh failed" >&2
  fi
  echo "updating installed skills:"
  local found=0
  for d in "$SKILLS_DIR"/*/; do
    [ -d "$d" ] || continue
    name="$(basename "$d")"
    if [ -n "$(line_for "$name")" ]; then
      if (fetch_skill "$name"); then
        echo "  updated $name"
        found=$((found + 1))
      else
        echo "  skillz: warn: failed to update $name" >&2
      fi
    fi
  done
  echo "updated $found skill(s)"
}

case "${1:-}" in
  list)    cmd_list ;;
  ls)      cmd_list ;;
  add)     shift; cmd_add "$@" ;;
  remove)  shift; cmd_remove "$@" ;;
  rm)      shift; cmd_remove "$@" ;;
  new)     shift; cmd_new "$@" ;;
  sync)    cmd_sync ;;
  update)  cmd_update ;;
  help)    cmd_help ;;
  -h|--help) cmd_help ;;
  *)       cmd_help; exit 1 ;;
esac
